PORT=8790
NODE_ENV=development

# Leave DATABASE_URL empty for in-memory demo mode.
DATABASE_URL=postgresql://sabre:sabre@localhost:5432/sabre_studio
DATABASE_SSL=false
AUTO_MIGRATE=true

# Required in production. SESSION_SECRET should be at least 32 random characters.
APP_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HOURS=336

# Railway Bucket or any S3-compatible object store.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET_NAME=sabre-videos
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=4294967296

FENCINGTV_DISCOVERY_ENABLED=true
FENCINGTV_CAPTURE_ENABLED=false

# Capture worker only. Generate this file with `npm run auth:fencingtv`.
FENCINGTV_STORAGE_STATE_PATH=/Users/you/.sabre-studio/fencingtv-storage-state.json
# For Railway, base64-encode the same file and use this variable instead of PATH.
FENCINGTV_STORAGE_STATE_BASE64=
FENCINGTV_BROWSER_EXECUTABLE=
FENCINGTV_HEADLESS=true
FENCINGTV_MAX_CLIP_SECONDS=7200
CAPTURE_WORKER_POLL_MS=5000
CAPTURE_WORKER_LEASE_SECONDS=900
CAPTURE_WORKER_MAX_ATTEMPTS=3
CAPTURE_WORKER_RETRY_BASE_SECONDS=60
