# InstantDB — create a free app at https://instantdb.com
VITE_INSTANT_APP_ID=your-instant-app-id
# Secret admin token from the Instant dashboard (keep out of git).
INSTANT_APP_ADMIN_TOKEN=your-instant-admin-token

# Railway S3-compatible object storage.
# In Railway: add a Bucket (object storage) service, then copy its connection
# details here. Any S3-compatible provider (MinIO, R2, AWS) works the same way.
# Leave all of these empty to store uploads on local disk (./uploads) in dev.
S3_ENDPOINT=https://your-bucket-endpoint.up.railway.app
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
