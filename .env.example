# InstantDB — create a free app at https://instantdb.com
VITE_INSTANT_APP_ID=your-instant-app-id
# Secret admin token from the Instant dashboard (keep out of git).
INSTANT_APP_ADMIN_TOKEN=your-instant-admin-token

# Optional API base URL for separate-client deployments.
# Keep empty for local Vite development and the combined Railway web service:
# both use same-origin /api requests (Vite proxies them during development).
# Rebuild after changing it — Vite bakes this value in at build time.
VITE_API_URL=

# Railway Storage Bucket — inject these with the "AWS SDK (Generic)" preset.
# Railway also supplies AWS_S3_URL_STYLE=virtual; this server defaults to that
# virtual-hosted style. All five values are required, including in local dev.
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional override for providers such as MinIO that require path-style URLs.
S3_FORCE_PATH_STYLE=false

# Comma-separated browser origins allowed to call the production API.
# Same-origin requests do not need an entry.
CORS_ALLOWED_ORIGINS=

# Authenticated single-PUT uploads are bounded to this many bytes (default 2 GiB).
# Multipart upload is not yet enabled; S3-compatible providers must accept a
# single presigned PUT up to this limit.
MEDIA_MAX_UPLOAD_BYTES=2147483648
MEDIA_ALLOWED_TYPES=video/mp4,video/quicktime,video/webm,video/x-m4v
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_CLEANUP_ENABLED=false
MEDIA_CLEANUP_INTERVAL_MS=21600000

# Analysis API/worker orchestration. The regular API starts without Redis;
# analysis endpoints return 503 until REDIS_URL is configured.
REDIS_URL=
ANALYSIS_QUEUE_ATTEMPTS=4
ANALYSIS_MAX_DURATION_SECONDS=7200
ANALYSIS_WINDOW_SECONDS=12
ANALYSIS_STRIDE_SECONDS=10
ANALYSIS_DEDUP_TOLERANCE_SECONDS=1.5
ANALYSIS_FINALIZATION_LOCK_MS=300000
ANALYSIS_FINALIZATION_WAIT_MS=300000
ANALYSIS_CLIP_RETENTION_HOURS=168
MEDIA_WORKER_CONCURRENCY=1
VLM_WORKER_CONCURRENCY=2

# Set the model identically on the API and VLM worker so config hashes and
# persisted audit fields match. Set the API key only on the VLM worker.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PROVIDER=
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_BASE64_FALLBACK=true
OPENROUTER_BASE64_MAX_BYTES=20971520
OPENROUTER_FRAME_FALLBACK=true
OPENROUTER_FRAME_SAMPLE_COUNT=8
OPENROUTER_FRAME_MAX_WIDTH=640
ANALYSIS_PROMPT_VERSION=phrase-end-award-v1

# External collection is intentionally disabled. Manual uploads remain active.
INGESTION_ENABLED=false
INGESTION_DRY_RUN=true
INGESTION_YOUTUBE_ENABLED=false
INGESTION_FENCINGTV_ENABLED=false

# Existing aliases remain supported for other S3-compatible providers:
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
