# InstantDB — create a free app at https://instantdb.com
VITE_INSTANT_APP_ID=your-instant-app-id
# Secret admin token from the Instant dashboard (keep out of git).
INSTANT_APP_ADMIN_TOKEN=your-instant-admin-token

# Optional API base URL for separate-client deployments.
# Keep empty for local Vite development and the combined Railway web service:
# both use same-origin /api requests (Vite proxies them during development).
# Rebuild after changing it — Vite bakes this value in at build time.
VITE_API_URL=

# Railway Storage Bucket — inject these with the "AWS SDK (Generic)" preset.
# Railway also supplies AWS_S3_URL_STYLE=virtual; this server defaults to that
# virtual-hosted style. All five values are required, including in local dev.
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional override for providers such as MinIO that require path-style URLs.
S3_FORCE_PATH_STYLE=false

# Existing aliases remain supported for other S3-compatible providers:
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
