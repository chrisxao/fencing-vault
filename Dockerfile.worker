FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV FENCINGTV_BROWSER_EXECUTABLE=/usr/bin/chromium
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates chromium ffmpeg \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY shared ./shared
COPY db ./db

CMD ["node", "--experimental-strip-types", "server/capture/worker.ts"]
