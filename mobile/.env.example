# Public InstantDB app ID used by the web app.
EXPO_PUBLIC_INSTANT_APP_ID=your-instant-app-id

# Reachable Express API origin, with no trailing slash.
# 127.0.0.1 works in the iOS simulator. For a physical device, use your
# computer's current LAN IP instead.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
